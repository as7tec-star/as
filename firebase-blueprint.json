{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Represents a customer or prospect in the CRM pipeline.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this client record."
        },
        "name": {
          "type": "string",
          "description": "The client name."
        },
        "phone": {
          "type": "string",
          "description": "Client phone number."
        },
        "email": {
          "type": "string",
          "description": "Client email address."
        },
        "source": {
          "type": "string",
          "description": "Client lead source.",
          "enum": ["حراج", "مرجان", "تيك توك", "فيسبوك", "واتساب", "أخرى"]
        },
        "status": {
          "type": "string",
          "description": "Pipeline stage of the client.",
          "enum": ["جديد", "تم التواصل", "مهتم", "تفاوض", "تم البيع", "خسرناه"]
        },
        "notes": {
          "type": "string",
          "description": "Internal notes regarding interactions."
        },
        "lastContactDate": {
          "type": "string",
          "description": "ISO date string or timestamp of last contact."
        },
        "dealValue": {
          "type": "number",
          "description": "Estimated deal or transaction value."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "name", "phone", "source", "status"]
    },
    "AdPost": {
      "title": "AdPost",
      "description": "Represents a product/service marketing post for classifieds and social media.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this ad."
        },
        "title": {
          "type": "string",
          "description": "Title or name of the product/service."
        },
        "price": {
          "type": "string",
          "description": "Price string or range."
        },
        "description": {
          "type": "string",
          "description": "Original raw product description."
        },
        "city": {
          "type": "string",
          "description": "Target city or location."
        },
        "platform": {
          "type": "string",
          "description": "Primary platform or general."
        },
        "status": {
          "type": "string",
          "description": "Publishing status.",
          "enum": ["لم ينشر", "نُشر", "يحتاج تجديد"]
        },
        "generatedVersions": {
          "type": "object",
          "description": "AI-generated versions for various platforms."
        },
        "renewalDays": {
          "type": "number",
          "description": "Days after which ad needs renewal."
        },
        "postUrl": {
          "type": "string",
          "description": "Published post URL."
        },
        "scheduledDate": {
          "type": "string",
          "description": "Scheduled post date."
        },
        "publishedAt": {
          "type": "string",
          "description": "Publication timestamp string."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["userId", "title", "description", "status"]
    },
    "MessageTemplate": {
      "title": "MessageTemplate",
      "description": "Customer messaging template for WhatsApp and Email.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user."
        },
        "title": {
          "type": "string",
          "description": "Template title."
        },
        "type": {
          "type": "string",
          "description": "Category of the message.",
          "enum": ["ترحيب", "متابعة", "عرض سعر", "شكر", "تذكير"]
        },
        "content": {
          "type": "string",
          "description": "The message body text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["userId", "title", "type", "content"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Price quotation document for items/services with Google Sheets sync.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user."
        },
        "quoteNumber": {
          "type": "string",
          "description": "Quotation reference number."
        },
        "clientId": {
          "type": "string",
          "description": "Linked client ID."
        },
        "clientName": {
          "type": "string",
          "description": "Name of the recipient client."
        },
        "clientPhone": {
          "type": "string",
          "description": "Client phone number."
        },
        "date": {
          "type": "string",
          "description": "Quotation issue date."
        },
        "expiryDate": {
          "type": "string",
          "description": "Quotation expiration date."
        },
        "status": {
          "type": "string",
          "description": "Quotation status.",
          "enum": ["مسودة", "مرسل", "مقبول", "مرفوض"]
        },
        "items": {
          "type": "array",
          "description": "Line items of the quote."
        },
        "subtotal": {
          "type": "number",
          "description": "Total before tax."
        },
        "taxRate": {
          "type": "number",
          "description": "VAT tax percentage."
        },
        "taxAmount": {
          "type": "number",
          "description": "Calculated VAT amount."
        },
        "grandTotal": {
          "type": "number",
          "description": "Total including tax."
        },
        "notes": {
          "type": "string",
          "description": "Terms, payment methods, delivery notes."
        },
        "googleSheetUrl": {
          "type": "string",
          "description": "Associated Google Sheet URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["userId", "quoteNumber", "clientName", "status"]
    },
    "BusinessTransaction": {
      "title": "BusinessTransaction",
      "description": "Sales or purchase invoice with precise VAT calculation.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID."
        },
        "type": {
          "type": "string",
          "description": "Transaction type.",
          "enum": ["مبيعات", "مشتريات"]
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Invoice or receipt reference number."
        },
        "partyName": {
          "type": "string",
          "description": "Customer or supplier name."
        },
        "partyPhone": {
          "type": "string",
          "description": "Customer or supplier phone."
        },
        "partyTaxNumber": {
          "type": "string",
          "description": "Optional VAT registration number."
        },
        "category": {
          "type": "string",
          "description": "Business category."
        },
        "date": {
          "type": "string",
          "description": "Invoice date YYYY-MM-DD."
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method.",
          "enum": ["نقدي", "تحويل بنكي", "شبكة / مدى", "آجل"]
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payment status.",
          "enum": ["مدفوع", "جزئي", "آجل"]
        },
        "taxMode": {
          "type": "string",
          "description": "Whether unit prices include VAT or exclude VAT or exempt.",
          "enum": ["غير شامل الضريبة", "شامل الضريبة", "معفى"]
        },
        "taxRate": {
          "type": "number",
          "description": "Tax percentage (e.g. 15.0)."
        },
        "items": {
          "type": "array",
          "description": "Invoice line items."
        },
        "subtotal": {
          "type": "number",
          "description": "Net amount before tax."
        },
        "discountTotal": {
          "type": "number",
          "description": "Total discount applied."
        },
        "taxAmount": {
          "type": "number",
          "description": "Calculated VAT amount."
        },
        "grandTotal": {
          "type": "number",
          "description": "Final total including tax."
        },
        "notes": {
          "type": "string",
          "description": "Additional invoice notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["userId", "type", "invoiceNumber", "partyName", "paymentStatus", "taxMode"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Staff member profile and salary structure.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID."
        },
        "name": {
          "type": "string",
          "description": "Employee full name."
        },
        "jobTitle": {
          "type": "string",
          "description": "Role or job title."
        },
        "department": {
          "type": "string",
          "description": "Department name."
        },
        "phone": {
          "type": "string",
          "description": "Employee phone number."
        },
        "email": {
          "type": "string",
          "description": "Employee email."
        },
        "nationalId": {
          "type": "string",
          "description": "National ID or Iqama number."
        },
        "hireDate": {
          "type": "string",
          "description": "Date of joining YYYY-MM-DD."
        },
        "baseSalary": {
          "type": "number",
          "description": "Monthly base salary."
        },
        "housingAllowance": {
          "type": "number",
          "description": "Monthly housing allowance."
        },
        "transportAllowance": {
          "type": "number",
          "description": "Monthly transport allowance."
        },
        "otherAllowances": {
          "type": "number",
          "description": "Other monthly allowances."
        },
        "defaultDeductions": {
          "type": "number",
          "description": "Default monthly deductions (e.g. GOSI)."
        },
        "bankIban": {
          "type": "string",
          "description": "Optional IBAN for salary transfer."
        },
        "status": {
          "type": "string",
          "description": "Employment status.",
          "enum": ["نشط", "إجازة", "منتهي الخدمة"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["userId", "name", "jobTitle", "status"]
    },
    "PayrollRecord": {
      "title": "PayrollRecord",
      "description": "Monthly salary slip and payment status for an employee.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID."
        },
        "employeeId": {
          "type": "string",
          "description": "Linked employee ID."
        },
        "employeeName": {
          "type": "string",
          "description": "Employee name snapshot."
        },
        "jobTitle": {
          "type": "string",
          "description": "Job title snapshot."
        },
        "employeePhone": {
          "type": "string",
          "description": "Employee phone snapshot."
        },
        "monthYear": {
          "type": "string",
          "description": "Payroll period YYYY-MM."
        },
        "baseSalary": {
          "type": "number",
          "description": "Base salary amount."
        },
        "allowances": {
          "type": "number",
          "description": "Total allowances."
        },
        "bonuses": {
          "type": "number",
          "description": "Bonuses or commissions."
        },
        "deductions": {
          "type": "number",
          "description": "Deductions or advances."
        },
        "netSalary": {
          "type": "number",
          "description": "Net payable salary."
        },
        "paymentStatus": {
          "type": "string",
          "description": "Payroll slip status.",
          "enum": ["مسودة", "معتمد", "مدفوع"]
        },
        "paymentDate": {
          "type": "string",
          "description": "Date paid YYYY-MM-DD."
        },
        "notes": {
          "type": "string",
          "description": "Payroll notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["userId", "employeeId", "employeeName", "monthYear", "paymentStatus"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product with stock quantity and low-stock alert threshold.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner UID."
        },
        "name": {
          "type": "string",
          "description": "Product name."
        },
        "sku": {
          "type": "string",
          "description": "SKU or barcode."
        },
        "category": {
          "type": "string",
          "description": "Product category."
        },
        "unit": {
          "type": "string",
          "description": "Unit of measure."
        },
        "quantity": {
          "type": "number",
          "description": "Current available stock quantity."
        },
        "minThreshold": {
          "type": "number",
          "description": "Minimum stock threshold before low-stock alert triggers."
        },
        "unitCost": {
          "type": "number",
          "description": "Purchase unit cost."
        },
        "sellingPrice": {
          "type": "number",
          "description": "Unit selling price."
        },
        "supplierName": {
          "type": "string",
          "description": "Primary supplier name."
        },
        "supplierPhone": {
          "type": "string",
          "description": "Supplier phone number for reorder."
        },
        "alertsEnabled": {
          "type": "boolean",
          "description": "Whether automatic low-stock alerts are enabled for this product."
        },
        "notes": {
          "type": "string",
          "description": "Optional product notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": ["userId", "name", "quantity", "minThreshold"]
    }
  },
  "firestore": {
    "/users/{userId}/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/Client"
      },
      "description": "User clients in the sales pipeline."
    },
    "/users/{userId}/ads/{adId}": {
      "schema": {
        "$ref": "#/entities/AdPost"
      },
      "description": "Marketing ad posts and multi-platform generated copy."
    },
    "/users/{userId}/templates/{templateId}": {
      "schema": {
        "$ref": "#/entities/MessageTemplate"
      },
      "description": "Message templates for customer follow-up and outreach."
    },
    "/users/{userId}/quotes/{quoteId}": {
      "schema": {
        "$ref": "#/entities/Quote"
      },
      "description": "User price quotations and Google Sheets integrated records."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/BusinessTransaction"
      },
      "description": "Sales and purchase invoices with VAT details."
    },
    "/users/{userId}/employees/{employeeId}": {
      "schema": {
        "$ref": "#/entities/Employee"
      },
      "description": "Company employees directory."
    },
    "/users/{userId}/payrolls/{payrollId}": {
      "schema": {
        "$ref": "#/entities/PayrollRecord"
      },
      "description": "Monthly payroll records and salary slips."
    },
    "/users/{userId}/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Inventory products and low-stock alert thresholds."
    }
  }
}
